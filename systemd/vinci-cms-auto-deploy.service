[Unit]
Description=Check and deploy the latest verified Vinci CMS commit
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathIsDirectory=@VINCI_ROOT@/.git

[Service]
Type=oneshot
User=@VINCI_USER@
Group=@VINCI_GROUP@
WorkingDirectory=@VINCI_ROOT@
ExecStart=@VINCI_ROOT@/vinci update --automatic
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=append:@VINCI_LOG_ROOT@/auto-deploy.log
StandardError=append:@VINCI_LOG_ROOT@/auto-deploy.log
