[Unit]
Description=Vinci CMS full database-to-content reconciliation
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@VINCI_USER@
Group=@VINCI_GROUP@
WorkingDirectory=@VINCI_ROOT@
ExecStart=@VINCI_ROOT@/vinci reconcile --scheduled
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=append:@VINCI_LOG_ROOT@/content-reconcile.log
StandardError=append:@VINCI_LOG_ROOT@/content-reconcile.log
