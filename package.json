{
  "name": "sdutvinci-website-nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "cms:admin": "tsx --env-file=.env scripts/cms-admin.ts",
    "cms:content:sync": "tsx --env-file=.env scripts/cms-content-sync.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/cms-migrate.ts",
    "generate": "nuxt generate",
    "test": "vitest run",
    "test:cms": "vitest run tests/cms-auth.integration.test.ts tests/cms-content.integration.test.ts tests/cms-drafts.integration.test.ts tests/cms-workflow.integration.test.ts tests/cms-protected-markdown.test.ts",
    "wiki:check": "node scripts/wiki-check.mjs",
    "typecheck": "nuxt typecheck",
    "prebuild": "npm run wiki:check",
    "pregenerate": "npm run wiki:check",
    "preview": "nuxt preview"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/kit": "^7.21.3",
    "@nuxt/content": "^3.15.2",
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.9.0",
    "diff": "^8.0.4",
    "drizzle-orm": "^0.45.2",
    "medium-zoom": "^1.1.0",
    "nuxt": "^4.5.0",
    "pg": "^8.22.0",
    "pinyin-pro": "^3.28.1",
    "remark": "^15.0.1",
    "vue": "^3.5.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "3.3.8"
  }
}
