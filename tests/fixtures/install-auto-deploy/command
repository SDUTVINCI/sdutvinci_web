#!/usr/bin/env bash

set -Eeuo pipefail
command_name="$(basename -- "$0")"
arguments=("$@")
printf '%s %s\n' "$command_name" "$*" >> "$FAKE_INSTALLER_LOG"

case "$command_name" in
  getent)
    case "${1:-}" in
      passwd)
        printf '%s:x:%s:%s::%s:/bin/bash\n' \
          "$2" "$FAKE_TEST_UID" "$FAKE_TEST_GID" "$FAKE_TEST_HOME"
        ;;
      group)
        printf '%s:x:%s:\n' "$FAKE_TEST_GROUP" "$FAKE_TEST_GID"
        ;;
      *) exit 64 ;;
    esac
    ;;
  docker)
    if [ "${1:-}" = info ]; then exit 0; fi
    if [ "${1:-}" = compose ] && [ "${2:-}" = config ]; then
      if [ "${3:-}" = --environment ]; then
        sed -n '/^[A-Za-z_][A-Za-z0-9_]*=/p' .env
      fi
      exit 0
    fi
    exit 64
    ;;
  find)
    if printf '%s\n' "$*" | grep -Fq ' ! -type d ! -type f '; then
      exit 0
    fi
    if printf '%s\n' "$*" | grep -Fq ' -user '; then
      if printf '%s\n' "$*" | grep -Fq ' -exec chown '; then
        touch "$FAKE_INSTALLER_STATE/legacy-chown.executed"
      else
        printf 'phase11legacy:phase11testgroup 700 %s/.deploy\n' "${1:-unknown}"
      fi
      exit 0
    fi
    exec /usr/bin/find "$@"
    ;;
  runuser)
    [ "${1:-}" = -u ] && [ "${3:-}" = -- ] || exit 64
    shift 3
    exec "$@"
    ;;
  stat)
    if [ "${1:-}" = -c ] && [ "${2:-}" = '%u' ] \
      && [ "${3:-}" = "$FAKE_REPOSITORY_ROOT" ]; then
      printf '%s\n' "$FAKE_TEST_UID"
      exit 0
    fi
    exec /usr/bin/stat "$@"
    ;;
  systemd-analyze|logrotate)
    exit 0
    ;;
  install)
    if [ "${1:-}" = -d ]; then
      mkdir -p -- "${arguments[$# - 1]}"
      exit 0
    fi
    source_file="${arguments[$# - 2]}"
    destination="${arguments[$# - 1]}"
    cp -- "$source_file" "$destination"
    chmod 0644 "$destination"
    ;;
  chown)
    exit 0
    ;;
  systemctl)
    case "${1:-}" in
      daemon-reload) ;;
      enable)
        timer="${arguments[$# - 1]}"
        touch "$FAKE_INSTALLER_STATE/${timer}.enabled"
        ;;
      disable) ;;
      *) exit 64 ;;
    esac
    ;;
  *) exit 64 ;;
esac
